<Window x:Class="DocumentGenerator.FieldLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагування поля форми"
        SizeToContent="Height"
        Width="440"
        MinWidth="380"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <StackPanel Margin="24">
        <TextBlock Text="Редагування поля форми"
                   FontSize="17" FontWeight="SemiBold"
                   Foreground="#0F172A"/>

        <TextBlock Text="Відображувана назва поля"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"
                   Margin="0,18,0,0"/>

        <TextBox x:Name="LabelBox"
                 Margin="0,8,0,0"
                 Padding="12,10"
                 MinHeight="40"
                 FontSize="13"
                 BorderBrush="#CBD5E1"
                 BorderThickness="1"
                 Background="#F8FAFC"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,28,0,0">
            <Button Content="Скасувати"
                    IsCancel="True"
                    Click="Cancel_Click"
                    Padding="18,10"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Background="#F1F5F9"
                    Foreground="#0F172A"
                    BorderThickness="0"
                    MinWidth="100"
                    MinHeight="36">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Зберегти"
                    IsDefault="True"
                    Click="Save_Click"
                    Padding="18,10"
                    Cursor="Hand"
                    Background="#0D9488"
                    Foreground="White"
                    BorderThickness="0"
                    MinWidth="100"
                    MinHeight="36">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
